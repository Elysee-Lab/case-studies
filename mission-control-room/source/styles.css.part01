:root{
  --paper:#f8f5ef;
  --paper-2:#fffdfa;
  --ink:#101820;
  --muted:#5f6871;
  --line:#ddd6ca;
  --accent:#8d5a2b;
  --accent-soft:#eadfce;
  --charcoal:#1a222a;
  --white:#fff;
  --shadow:0 18px 48px rgba(43,34,23,.07);
  --max:1240px;
  --radius:26px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--paper);
  color:var(--ink);
  font-family:"DM Sans",Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  line-height:1.6;
  text-rendering:optimizeLegibility;
}
img{max-width:100%;display:block}
a{color:inherit}
button{font:inherit}
::selection{background:var(--accent-soft)}
.wrap{width:min(var(--max),calc(100% - 48px));margin-inline:auto}
.progress{
  position:fixed;inset:0 auto auto 0;width:0;height:3px;
  background:var(--accent);z-index:90;
}
.top{
  position:sticky;top:0;z-index:60;
  background:rgba(248,245,239,.94);
  border-bottom:1px solid rgba(16,24,32,.09);
  backdrop-filter:blur(18px);
}
.top-main{
  min-height:78px;
  display:flex;align-items:center;justify-content:space-between;gap:24px;
}
.brand strong{
  display:block;
  font-family:"Playfair Display",Georgia,serif;
  font-size:1.55rem;line-height:1.05;letter-spacing:-.02em;
}
.brand span{display:block;color:var(--muted);font-size:.82rem;margin-top:5px}
.lang-switch{
  display:flex;align-items:center;padding:4px;border:1px solid #d6d0c7;
  border-radius:999px;background:#fff;
}
.lang-switch button{
  border:0;background:transparent;color:#59636c;cursor:pointer;
  padding:9px 15px;border-radius:999px;font-weight:700;
}
.lang-switch button.active{background:var(--charcoal);color:#fff}
.nav-row{border-top:1px solid rgba(16,24,32,.05)}
.nav{
  display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:14px;
  align-items:end;justify-content:space-between;overflow:visible;
  padding:14px 0 13px;
}
.nav::-webkit-scrollbar{display:none}
.nav a{
  min-width:0;text-decoration:none;color:#4d5760;text-align:center;white-space:nowrap;
  font-size:clamp(.72rem,.8vw,.84rem);font-weight:600;padding:0 2px 9px;border-bottom:2px solid transparent;
}
.nav a.active,.nav a:hover{color:var(--ink);border-bottom-color:var(--accent)}
.hero,.section{scroll-margin-top:134px}
.hero{
  min-height:78vh;
  display:flex;align-items:center;
  padding:92px 0 76px;
  border-bottom:1px solid rgba(16,24,32,.08);
  background:
    radial-gradient(circle at 80% 20%,rgba(141,90,43,.08),transparent 25%),
    linear-gradient(180deg,var(--paper-2),var(--paper));
}
.hero-grid{
  display:grid;grid-template-columns:1.05fr .95fr;gap:72px;align-items:center;
}
.eyebrow,.section-no{
  color:var(--accent);text-transform:uppercase;letter-spacing:.24em;
  font-size:.72rem;font-weight:700;
}
.eyebrow{display:flex;align-items:center;gap:12px}
.eyebrow:before{content:"";width:42px;height:1px;background:currentColor}
h1,h2,h3,.display{
  font-family:"Playfair Display",Georgia,serif;
  letter-spacing:-.035em;
  margin:0;
}
h1{
  font-size:clamp(4rem,7.5vw,7.6rem);
  line-height:.9;
  max-width:820px;
}
h2{font-size:clamp(2.9rem,5vw,5rem);line-height:.98}
h3{font-size:1.45rem;line-height:1.08}
.hero-lead{
  font-family:"Playfair Display",Georgia,serif;
  font-size:clamp(1.3rem,2.1vw,2rem);
  color:#3f4851;line-height:1.28;max-width:760px;margin:28px 0 0;
}
.hero-copy{font-size:1.02rem;color:#4f5962;max-width:700px;margin:24px 0 0}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:10px;
  text-decoration:none;padding:13px 19px;border-radius:999px;font-weight:700;
  border:1px solid #cbc3b8;background:#fff;transition:.2s ease;
}
.btn.primary{background:var(--charcoal);color:#fff;border-color:var(--charcoal)}
.btn:hover{transform:translateY(-1px)}
.hero-visual{
  position:relative;min-height:0;
  display:block;
}
.signal-board{
  position:relative;background:#f2ece2;border:1px solid #ded4c5;border-radius:34px;
  padding:34px;box-shadow:var(--shadow);overflow:hidden;
}
.signal-board:after{
  content:"";position:absolute;width:240px;height:240px;border-radius:50%;
  right:-80px;top:-70px;background:rgba(141,90,43,.08);
}
.signal-title{
  font-family:"Playfair Display",Georgia,serif;font-size:2rem;line-height:1.08;
}
.flow-mini{display:grid;gap:13px;margin-top:28px}
.flow-mini .row{
  display:grid;grid-template-columns:42px 1fr auto;gap:13px;align-items:center;
  padding:13px 0;border-top:1px solid rgba(16,24,32,.11);
}
.flow-mini .row:first-child{border-top:0}
.icon{
  width:38px;height:38px;border:1px solid #d6c9b7;border-radius:50%;
  display:grid;place-items:center;color:var(--accent);background:#fff;
}
.flow-copy{display:grid;gap:4px;min-width:0}
.flow-mini b{display:block;font-size:.92rem;line-height:1.25}
.flow-mini small{display:block;color:var(--muted);line-height:1.45}
.signal-tag{
  color:var(--accent);font-size:.72rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
}
.hero-note{
  position:static;width:min(360px,88%);margin:16px 10px 0 auto;background:#fff;
  border:1px solid #dfd8ce;border-radius:18px;padding:18px 20px;
  transform:rotate(-1deg);box-shadow:var(--shadow);
  font-family:"Playfair Display",Georgia,serif;font-style:italic;font-size:1.08rem;line-height:1.45;
}
.evidence-strip{
  display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
  border:1px solid var(--line);background:var(--line);margin-top:54px;
}
.evidence-item{background:var(--paper-2);padding:22px}
.evidence-item b{
  display:block;font-family:"Playfair Display",Georgia,serif;font-size:1.4rem;margin-bottom:5px
}
.evidence-item span{color:var(--muted);font-size:.88rem}
.section{padding:104px 0;border-bottom:1px solid rgba(16,24,32,.08)}
.section.alt{background:var(--paper-2)}
.section-head{
  display:grid;grid-template-columns:.45fr 1.55fr;gap:44px;margin-bottom:48px;
}
.section-intro{max-width:830px}
.section-intro p{color:var(--muted);font-size:1.05rem;margin:18px 0 0}
.editorial-grid{
  display:grid;grid-template-columns:.82fr 1.18fr;gap:26px;align-items:stretch;
}
.editorial-card{
  background:#fff;border:1px solid var(--line);border-radius:var(--radius);
  padding:32px;box-shadow:0 10px 30px rgba(43,34,23,.035);
}
.big-line{
  font-family:"Playfair Display",Georgia,serif;font-size:clamp(2rem,3.2vw,3.2rem);
  line-height:1.02;margin:0 0 22px;
}
.muted{color:var(--muted)}
.problem-grid,.principles,.results-grid,.learning-grid{
  display:grid;grid-template-columns:repeat(4,1fr);gap:14px;
}
.problem,.principle,.result,.learning{
  background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;
}
.problem h3,.principle h3,.result h3,.learning h3{font-size:1.12rem;margin:14px 0 6px}
.problem p,.principle p,.result p,.learning p{color:var(--muted);font-size:.92rem;margin:0}
.process{
  display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin-top:28px;
}
.step{
  position:relative;padding:18px 14px 20px;border-top:1px solid var(--line);
}
.step:not(:last-child):after{
